rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{document=**} {
      // Push endpoints and reminder episode state are server-managed. The
      // Firebase Admin SDK bypasses these rules; browser clients cannot read
      // or write these documents.
      allow read, write: if collection != 'pushSubscriptions'
        && collection != 'pushNotificationEpisodes';
    }
  }
}
